# Copy to .env for local work. On Railway set these as service variables instead.
# Railway provides PORT itself -- do not set it.

# --- Required -------------------------------------------------------------
OPENAI_API_KEY=sk-...
BRAVE_API_KEY=...

# --- Required once the backend has a public address -----------------------
# Without this the verification endpoints are open to anyone who finds the URL,
# and every request they make spends your OpenAI and Brave credit.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# The same value goes into both clients via scripts/set-backend-url.mjs.
IRIS_API_TOKEN=

# --- Models ---------------------------------------------------------------
# Both are baked into the image by the Dockerfile; these only matter elsewhere.
IRIS_MODEL_CACHE=.hf_cache
EASYOCR_MODULE_PATH=.easyocr
IRIS_OCR_GPU=false

# --- Tuning ---------------------------------------------------------------
# Claims of one post checked at a time. Three was measured fastest on twelve
# cores; on a two-vCPU container 2 leaves more room for other people's checks.
IRIS_CLAIM_WORKERS=3

# --- Developer tooling: leave off in front of testers ----------------------
# TRACE returns 404 while this is false. If you turn it on for a hosted
# backend you must also set a token, or it refuses every non-local request.
IRIS_TRACE_ENABLED=false
IRIS_TRACE_TOKEN=
