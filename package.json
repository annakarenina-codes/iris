{
  "name": "iris-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "extension:build": "pnpm --dir iris-extension build",
    "extension:dev": "pnpm --dir iris-extension dev",
    "app:build": "pnpm --dir iris-app build",
    "app:dev": "pnpm --dir iris-app dev",
    "backend:run": "python iris-backend/app.py"
  },
  "workspaces": [
    "iris-extension",
    "iris-app"
  ]
}
