    <string name="privacy_sources_title">المصادر المعتمدة</string>
    <string name="privacy_sources_detail">يفحص IRIS ملفات VERA وRappler إضافة إلى ABS-CBN وGMA وInquirer وPhilStar وManila Bulletin وPNA وPIA وDZRH وOneNews.</string>

