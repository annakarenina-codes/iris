    <string name="workflow_select_title">文本选择</string>
    <string name="workflow_select_detail">在支持的应用中，Android 文本工具栏会显示“用 IRIS 检查”。</string>
    <string name="workflow_share_title">图片分享</string>
    <string name="workflow_share_detail">将图片帖子分享给 IRIS；应用会将其发送到 /verify-image 进行 OCR，然后显示声明结果。</string>

    <!-- Privacy and sources -->
    <string name="privacy_eyebrow">隐私与来源</string>
    <string name="privacy_title">由用户掌控的验证</string>
    <string name="privacy_trigger_title">仅由用户触发</string>
    <string name="privacy_trigger_detail">IRIS 不会自动监控其他应用；只有当您提交文本或图片时才会开始检查。</string>
    <string name="privacy_clipboard_title">隐私优先</string>
    <string name="privacy_clipboard_detail">只有在气泡内点按“从剪贴板粘贴”后，或开启自动打开并打开面板时，才会读取剪贴板。</string>
    <string name="privacy_sources_title">认可的来源</string>
    <string name="privacy_sources_detail">IRIS 检查 VERA Files、Rappler 以及 ABS-CBN、GMA、Inquirer、PhilStar、Manila Bulletin、PNA、PIA、DZRH 和 OneNews。</string>

