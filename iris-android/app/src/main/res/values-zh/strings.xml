    <string name="manual_title">手动文本与图片检查</string>
    <string name="manual_desc">粘贴一条声明或选择一张截图，IRIS 将对照菲律宾新闻来源进行检查。</string>
    <string name="manual_input_hint">粘贴或输入要验证的声明</string>
    <string name="manual_pick_image">选择图片进行检查</string>

