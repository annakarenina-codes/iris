    <string name="appearance_eyebrow">外观</string>
    <string name="theme_title">主题</string>
    <string name="theme_desc">跟随系统设置，或为 IRIS 强制使用浅色或深色。</string>
    <string name="theme_system">系统</string>
    <string name="theme_light">浅色</string>
    <string name="theme_dark">深色</string>

    <!-- Language -->
    <string name="language_eyebrow">语言</string>
    <string name="language_title">应用语言</string>
    <string name="language_desc">选择 IRIS 在整个应用中使用的语言。</string>

    <!-- Android workflow -->
    <string name="workflow_eyebrow">Android 工作流程</string>
    <string name="workflow_title">三种由用户触发的入口</string>
    <string name="workflow_paste_title">Facebook 粘贴</string>
