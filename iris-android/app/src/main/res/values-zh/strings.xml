    <string name="backend_eyebrow">后端</string>
    <string name="backend_title">连接</string>
    <string name="backend_desc">当 Flask 后端与模拟器在同一台笔记本上运行时，请使用 10.0.2.2。</string>
    <string name="backend_save">保存后端地址</string>
    <string name="status_backend_saved">后端地址已保存。</string>

