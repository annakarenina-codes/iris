    <string name="hero_subtitle">启用浮动气泡、粘贴复制的 Facebook 文本、在支持的应用中使用 Android 文本菜单，或将图片分享给 IRIS 进行 OCR 验证。</string>

    <!-- Status strip -->
    <string name="status_ready_title">准备就绪，随时核查</string>
    <string name="status_ready_detail">IRIS 只会检查您主动提交的文本或图片。</string>

